{
	"name": "@earendil-works/pi-env",
	"version": "1.4.0-exo.15",
	"private": true,
	"description": "Remote execution environments for Pi Durable: a small daemon deployed over SSH and its ExecutionEnv client",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"bin",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"build:daemon": "cargo build --manifest-path daemon/Cargo.toml --locked",
		"test": "node scripts/test.mjs",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"durable-execution",
		"agents",
		"ssh",
		"remote"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/exowatt-oss/phi",
		"directory": "packages/env"
	},
	"bugs": { "url": "https://github.com/exowatt-oss/phi/issues" },
	"homepage": "https://github.com/exowatt-oss/phi",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0-exo.15",
		"@earendil-works/pi-durable": "1.4.0-exo.15"
	},
	"devDependencies": {
		"shx": "0.3.4",
		"vitest": "4.1.11"
	}
}
