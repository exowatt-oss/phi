{
	"name": "@earendil-works/pi-telemetry",
	"version": "1.4.0-exo.15",
	"private": true,
	"description": "Vendor-neutral telemetry contracts and typed schema utilities for pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./render": {
			"source": "./src/render.ts",
			"types": "./dist/render.d.ts",
			"import": "./dist/render.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run --maxWorkers=4",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/exowatt-oss/phi",
		"directory": "packages/telemetry"
	},
	"bugs": { "url": "https://github.com/exowatt-oss/phi/issues" },
	"homepage": "https://github.com/exowatt-oss/phi",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11"
	}
}
